            text-decoration: none;
        }
        
        .logo i {
            color: #4CAF50;
            margin-right: 10px;
        }
        
        .nav-links a {
            margin-left: 30px;
            text-decoration: none;
            color: #333;
            font-weight: 500;
        }
        
        .page-header {
            background: linear-gradient(135deg, #1B5E20, #4CAF50);
            color: white;
            padding: 60px 0;
            text-align: center;
        }
        
        .page-header h1 {
            font-size: 48px;
            margin-bottom: 20px;
        }
        
        .search-box {
            max-width: 600px;
            margin: 30px auto 0;
            display: flex;
            gap: 10px;
        }
        
        .search-box input {
            flex: 1;
            padding: 15px 20px;
            border: none;
            border-radius: 50px;
            font-size: 16px;
        }
        
        .search-box button {
            padding: 15px 40px;
            background: #ff5722;
            color: white;
            border: none;
            border-radius: 50px;
            cursor: pointer;
            font-weight: 600;
        }
        
        .stats-bar {
            background: white;
            border-radius: 20px;
            padding: 30px;
            margin: 40px 0;
            display: grid;
            grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));
            gap: 20px;
            text-align: center;
        }
        
        .stat-item {
            padding: 20px;
        }
        
        .stat-number {
            font-size: 36px;
            font-weight: 700;
            color: #1B5E20;
        }
        
        .stat-label {
            color: #666;
        }
        
        .tuman-filter {
            display: flex;
            flex-wrap: wrap;
            gap: 10px;
            margin: 30px 0;
            justify-content: center;
        }
        
        .filter-btn {
            padding: 10px 25px;
            border: 2px solid #4CAF50;
            background: white;
            color: #4CAF50;
            border-radius: 50px;
            cursor: pointer;
            font-weight: 600;
            transition: 0.3s;
        }
        
        .filter-btn:hover,
        .filter-btn.active {
            background: #4CAF50;
            color: white;
        }
        
        .mahallalar-grid {
            display: grid;
            grid-template-columns: repeat(auto-fill, minmax(350px, 1fr));
            gap: 25px;
            margin: 40px 0;
        }
        
        .mahalla-card {
            background: white;
            border-radius: 20px;
            padding: 25px;
            box-shadow: 0 10px 30px rgba(0,0,0,0.1);
            transition: 0.3s;
            cursor: pointer;
            border-left: 5px solid #4CAF50;
        }
        
        .mahalla-card:hover {
            transform: translateY(-5px);
            box-shadow: 0 20px 40px rgba(0,0,0,0.2);
        }
        
        .mahalla-nomi {
            font-size: 20px;
            font-weight: 700;
            color: #1B5E20;
            margin-bottom: 15px;
        }
        
        .mahalla-info {
            margin: 10px 0;
            display: flex;
            align-items: center;
            gap: 10px;
            color: #666;
        }
        
        .mahalla-info i {
            width: 20px;
            color: #4CAF50;
        }
        
        .badge {
            display: inline-block;
            padding: 5px 12px;
            background: #E8F5E9;
            color: #2E7D32;
            border-radius: 50px;
            font-size: 12px;
            font-weight: 600;
            margin-right: 5px;
        }
        
        .pagination {
            display: flex;
            justify-content: center;
            gap: 10px;
            margin: 40px 0;
        }
        
        .page-btn {
            width: 40px;
            height: 40px;
            display: flex;
            align-items: center;
            justify-content: center;
            border: 2px solid #4CAF50;
            border-radius: 10px;
            color: #4CAF50;
            text-decoration: none;
            font-weight: 600;
            transition: 0.3s;

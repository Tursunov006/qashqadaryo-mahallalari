<!DOCTYPE html>
<html lang="uz">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Qashqadaryo Mahallalari | Rasmiy platforma</title>
    
    <!-- Fonts & Icons -->
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.2/css/all.min.css">
    
    <!-- AOS Animation -->
    <link href="https://unpkg.com/aos@2.3.1/dist/aos.css" rel="stylesheet">
    
    <style>
        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
        }
        
        body {
            font-family: 'Inter', sans-serif;
            background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
            min-height: 100vh;
            color: #333;
        }
        
        /* Navbar */
        .navbar {
            background: rgba(255, 255, 255, 0.95);
            backdrop-filter: blur(10px);
            box-shadow: 0 2px 20px rgba(0,0,0,0.1);
            padding: 1rem 0;
            position: sticky;
            top: 0;
            z-index: 1000;
        }
        
        .nav-container {
            max-width: 1200px;
            margin: 0 auto;
            padding: 0 2rem;
            display: flex;
            justify-content: space-between;
            align-items: center;
        }
        
        .logo {
            font-size: 1.8rem;
            font-weight: 700;
            color: #2E7D32;
            text-decoration: none;
            display: flex;
            align-items: center;
        }
        
        .logo i {
            color: #4CAF50;
            margin-right: 10px;
            font-size: 2rem;
        }
        
        .nav-links {
            display: flex;
            gap: 2rem;
            align-items: center;
        }
        
        .nav-links a {
            text-decoration: none;
            color: #333;
            font-weight: 500;
            transition: 0.3s;
        }
        
        .nav-links a:hover {
            color: #4CAF50;
        }
        
        .btn-outline {
            padding: 0.5rem 1.5rem;
            border: 2px solid #4CAF50;
            border-radius: 50px;
            color: #4CAF50;
        }
        
        .btn-outline:hover {
            background: #4CAF50;
            color: white;
        }
        
        .btn-primary {
            padding: 0.5rem 1.5rem;
            background: linear-gradient(135deg, #4CAF50, #2E7D32);
            border-radius: 50px;
            color: white;
        }
        
        /* Hero Section */
        .hero {
            background: linear-gradient(135deg, #1B5E20, #4CAF50);
            color: white;
            padding: 6rem 2rem;
            text-align: center;
            position: relative;
            overflow: hidden;
        }
        
        .hero::before {
            content: '';
            position: absolute;
            top: -50%;
            right: -50%;
            width: 200%;
            height: 200%;
            background: radial-gradient(circle, rgba(255,255,255,0.1) 0%, transparent 50%);
            animation: rotate 30s linear infinite;
        }
        
        @keyframes rotate {
            from { transform: rotate(0deg); }
            to { transform: rotate(360deg); }
        }
        
        .hero-content {
            position: relative;
            z-index: 1;
            max-width: 800px;
            margin: 0 auto;
        }
        
        .hero h1 {
            font-size: 3.5rem;
            font-weight: 700;
            margin-bottom: 1.5rem;
        }
        
        .hero h1 i {
            animation: bounce 2s infinite;
            display: inline-block;
        }
        
        @keyframes bounce {
            0%, 100% { transform: translateY(0); }
            50% { transform: translateY(-10px); }
        }
        
        .hero p {
            font-size: 1.2rem;
            margin-bottom: 2rem;
            opacity: 0.95;
        }
        
        .search-box {
            max-width: 600px;
            margin: 0 auto;
            position: relative;
        }
        
        .search-box input {
            width: 100%;
            padding: 1.2rem 1.5rem;
            border: none;
            border-radius: 50px;
            font-size: 1rem;
            box-shadow: 0 10px 30px rgba(0,0,0,0.2);
        }
        
        .search-box button {
            position: absolute;
            right: 5px;
            top: 5px;
            background: #4CAF50;
            color: white;
            border: none;
            padding: 0.8rem 2rem;
            border-radius: 50px;
            cursor: pointer;
            font-weight: 600;
            transition: 0.3s;
        }
        
        .search-box button:hover {
            background: #2E7D32;
            transform: scale(1.05);
        }
        
        /* Container */
        .container {
            max-width: 1200px;
            margin: 0 auto;
            padding: 3rem 2rem;
        }
        
        /* Stats */
        .stats-grid {
            display: grid;
            grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));
            gap: 2rem;
            margin: 4rem 0;
        }
        
        .stat-card {
            background: white;
            border-radius: 20px;
            padding: 2rem;
            text-align: center;
            box-shadow: 0 10px 30px rgba(0,0,0,0.1);
            transition: 0.3s;
            cursor: pointer;
        }
        
        .stat-card:hover {
            transform: translateY(-10px);
            box-shadow: 0 20px 40px rgba(0,0,0,0.2);
        }
        
        .stat-icon {
            width: 70px;
            height: 70px;
            background: linear-gradient(135deg, #4CAF50, #2E7D32);
            border-radius: 50%;
            display: flex;
            align-items: center;
            justify-content: center;
            margin: 0 auto 1.5rem;
        }
        
        .stat-icon i {
            font-size: 2rem;
            color: white;
        }
        
        .stat-number {
            font-size: 2.5rem;
            font-weight: 700;
            color: #1B5E20;
        }
        
        .stat-label {
            color: #666;
            font-size: 1rem;
        }
        
        /* Cards */
        .section-title {
            text-align: center;
            color: white;
            margin-bottom: 3rem;
        }
        
        .section-title h2 {
            font-size: 2.5rem;
            font-weight: 700;
        }
        
        .cards-grid {
            display: grid;
            grid-template-columns: repeat(auto-fit, minmax(300px, 1fr));
            gap: 2rem;
        }
        
        .card {
            background: white;
            border-radius: 30px;
            padding: 2.5rem;
            box-shadow: 0 10px 30px rgba(0,0,0,0.1);
            transition: 0.3s;
            cursor: pointer;
            text-decoration: none;
            color: #333;
            display: block;
            position: relative;
            overflow: hidden;
        }
        
        .card::before {
            content: '';
            position: absolute;
            top: 0;
            left: 0;
            width: 100%;
            height: 5px;
            background: linear-gradient(90deg, #4CAF50, #2E7D32);
        }
        
        .card:hover {
            transform: translateY(-10px);
            box-shadow: 0 20px 40px rgba(0,0,0,0.2);
        }
        
        .card-icon {
            width: 70px;
            height: 70px;
            background: #E8F5E9;
            border-radius: 20px;
            display: flex;
            align-items: center;
            justify-content: center;
            margin-bottom: 1.5rem;
        }
        
        .card-icon i {
            font-size: 2.5rem;
            color: #4CAF50;
        }
        
        .card h3 {
            font-size: 1.5rem;
            margin-bottom: 0.5rem;
            color: #1B5E20;
        }
        
        .card p {
            color: #666;
            margin-bottom: 1.5rem;
        }
        
        .card-link {
            color: #4CAF50;
            font-weight: 600;
            display: flex;
            align-items: center;
            gap: 0.5rem;
        }
        
        .card-link i {
            transition: 0.3s;
        }
        
        .card:hover .card-link i {
            transform: translateX(5px);
        }
        
        /* OneID Section */
        .oneid-section {
            background: white;
            border-radius: 30px;
            padding: 3rem;
            margin: 4rem 0;
            text-align: center;
            box-shadow: 0 10px 30px rgba(0,0,0,0.1);
        }
        
        .oneid-icon {
            width: 100px;
            height: 100px;
            background: linear-gradient(135deg, #1B5E20, #4CAF50);
            border-radius: 50%;
            display: flex;
            align-items: center;
            justify-content: center;
            margin: 0 auto 1.5rem;
        }
        
        .oneid-icon i {
            font-size: 3rem;
            color: white;
        }
        
        .oneid-btn {
            display: inline-flex;
            align-items: center;
            gap: 1rem;
            background: linear-gradient(135deg, #1B5E20, #2E7D32);
            color: white;
            text-decoration: none;
            padding: 1rem 3rem;
            border-radius: 50px;
            font-weight: 600;
            font-size: 1.2rem;
            margin: 1.5rem 0;
            transition: 0.3s;
            border: 2px solid #4CAF50;
        }
        
        .oneid-btn:hover {
            transform: translateY(-5px);
            box-shadow: 0 10px 30px rgba(76,175,80,0.4);
        }
        
        .oneid-btn img {
            height: 30px;
            filter: brightness(0) invert(1);
        }
        
        .security-badge {
            display: flex;
            align-items: center;
            justify-content: center;
            gap: 1rem;
            color: #666;
            font-size: 0.9rem;
        }
        
        .security-badge i {
            color: #4CAF50;
        }
        
        /* Emergency */
        .emergency-bar {
            background: #ff5722;
            color: white;
            padding: 1.5rem;
            border-radius: 20px;
            display: flex;
            justify-content: center;
            gap: 3rem;
            flex-wrap: wrap;
            margin: 3rem 0;
        }
        
        .emergency-item {
            display: flex;
            align-items: center;
            gap: 0.5rem;
            font-size: 1.2rem;
        }
        
        .emergency-item i {
            font-size: 1.5rem;
        }
        
        .emergency-item span {
            font-weight: 700;
        }
        
        /* Footer */
        .footer {
            background: #1B5E20;
            color: white;
            padding: 3rem 0;
            margin-top: 4rem;
        }
        
        .footer-content {
            max-width: 1200px;
            margin: 0 auto;
            padding: 0 2rem;
            display: grid;
            grid-template-columns: repeat(auto-fit, minmax(250px, 1fr));
            gap: 3rem;
        }
        
        .footer-section h4 {
            margin-bottom: 1.5rem;
            font-size: 1.2rem;
        }
        
        .footer-section ul {
            list-style: none;
        }
        
        .footer-section ul li {
            margin-bottom: 0.8rem;
        }
        
        .footer-section ul li a {
            color: rgba(255,255,255,0.8);
            text-decoration: none;
        }
        
        .footer-section ul li a:hover {
            color: white;
        }
        
        .footer-bottom {
            text-align: center;
            padding-top: 2rem;
            margin-top: 2rem;
            border-top: 1px solid rgba(255,255,255,0.1);
        }
        
        /* Responsive */
        @media (max-width: 768px) {
            .hero h1 {
                font-size: 2.5rem;
            }
            
            .nav-links {
                display: none;
            }
            
            .emergency-bar {
                flex-direction: column;
                gap: 1rem;
                text-align: center;
            }
        }
    </style>
</head>
<body>
    <!-- Navbar -->
    <nav class="navbar">
        <div class="nav-container">
            <a href="/" class="logo">
                <i class="fas fa-map-marked-alt"></i>
                Qashqadaryo MFY
            </a>
            
            <div class="nav-links">
                <a href="/">Bosh sahifa</a>
                <a href="/qashqadaryo">Tumanlar</a>
                <a href="/qashqadaryo/xizmatlar">24/7 Xizmatlar</a>
                
                <% if (faol) { %>
                    <a href="/faollar/dashboard" class="btn-primary">
                        <i class="fas fa-user-tie me-2"></i><%= faol.ism %>
                    </a>
                <% } else if (user) { %>
                    <a href="/faollar/login" class="btn-outline">
                        <i class="fas fa-user me-2"></i><%= user.ism %>
                    </a>
                <% } else { %>
                    <a href="/faollar/login" class="btn-outline">
                        <i class="fas fa-sign-in-alt me-2"></i>Kirish
                    </a>
                <% } %>
            </div>
        </div>
    </nav>

    <!-- Hero Section -->
    <section class="hero">
        <div class="hero-content" data-aos="fade-up">
            <h1>
                <i class="fas fa-map-marked-alt"></i>
                Qashqadaryo Mahallalari
            </h1>
            <p>Viloyatimizdagi barcha mahallalar va 24/7 xizmatlar</p>
            
            <div class="search-box">
                <form action="/qashqadaryo/izlash" method="GET">
                    <input type="text" name="q" placeholder="Mahalla nomini kiriting...">
                    <button type="submit">
                        <i class="fas fa-search me-2"></i>Qidirish
                    </button>
                </form>
            </div>
        </div>
    </section>

    <!-- Statistics -->
    <div class="container">
        <div class="stats-grid">
            <div class="stat-card" data-aos="fade-up">
                <div class="stat-icon">
                    <i class="fas fa-map"></i>
                </div>
                <div class="stat-number">15</div>
                <div class="stat-label">Tumanlar</div>
            </div>
            
            <div class="stat-card" data-aos="fade-up" data-aos-delay="100">
                <div class="stat-icon">
                    <i class="fas fa-home"></i>
                </div>
                <div class="stat-number">558</div>
                <div class="stat-label">Mahallalar</div>
            </div>
            
            <div class="stat-card" data-aos="fade-up" data-aos-delay="200">
                <div class="stat-icon">
                    <i class="fas fa-clock"></i>
                </div>
                <div class="stat-number">124</div>
                <div class="stat-label">24/7 Xizmatlar</div>
            </div>
            
            <div class="stat-card" data-aos="fade-up" data-aos-delay="300">
                <div class="stat-icon">
                    <i class="fas fa-users"></i>
                </div>
                <div class="stat-number">3.5M+</div>
                <div class="stat-label">Aholi</div>
            </div>
        </div>

        <!-- Emergency Bar -->
        <div class="emergency-bar" data-aos="fade-up">
            <div class="emergency-item">
                <i class="fas fa-ambulance"></i>
                <span>103</span> Tez yordam
            </div>
            <div class="emergency-item">
                <i class="fas fa-fire-extinguisher"></i>
                <span>101</span> Yong'in
            </div>
            <div class="emergency-item">
                <i class="fas fa-shield-alt"></i>
                <span>102</span> Militsiya
            </div>
            <div class="emergency-item">
                <i class="fas fa-burn"></i>
                <span>104</span> Gaz
            </div>
            <div class="emergency-item">
                <i class="fas fa-bolt"></i>
                <span>105</span> Elektr
            </div>
            <div class="emergency-item">
                <i class="fas fa-water"></i>
                <span>106</span> Suv
            </div>
        </div>

        <!-- Main Cards -->
        <div class="section-title">
            <h2>Platforma imkoniyatlari</h2>
        </div>
        
        <div class="cards-grid">
            <a href="/qashqadaryo" class="card" data-aos="fade-up">
                <div class="card-icon">
                    <i class="fas fa-map-marked-alt"></i>
                </div>
                <h3>Qashqadaryo</h3>
                <p>Viloyatimizdagi barcha tumanlar va mahallalar</p>
                <div class="card-link">
                    15 ta tuman <i class="fas fa-arrow-right"></i>
                </div>
            </a>
            
            <a href="/qashqadaryo/xizmatlar" class="card" data-aos="fade-up" data-aos-delay="100">
                <div class="card-icon">
                    <i class="fas fa-clock"></i>
                </div>
                <h3>24/7 Xizmatlar</h3>
                <p>Favqulodda va kunlik xizmatlar</p>
                <div class="card-link">
                    124 ta xizmat <i class="fas fa-arrow-right"></i>
                </div>
            </a>
            
            <a href="/faollar/login" class="card" data-aos="fade-up" data-aos-delay="200">
                <div class="card-icon">
                    <i class="fas fa-user-tie"></i>
                </div>
                <h3>Faollar kabineti</h3>
                <p>Mahalla faollari uchun shaxsiy kabinet</p>
                <div class="card-link">
                    Kirish <i class="fas fa-arrow-right"></i>
                </div>
            </a>
        </div>

        <!-- OneID Section -->
        <div class="oneid-section" data-aos="zoom-in">
            <div class="oneid-icon">
                <i class="fas fa-shield-alt"></i>
            </div>
            <h2>OneID orqali tez va xavfsiz kirish</h2>
            <p>My.gov.uz login va parolingiz bilan tizimga kiring</p>
            
            <a href="/auth/oneid" class="oneid-btn">
                <img src="https://my.gov.uz/assets/logo.png" alt="OneID">
                OneID orqali kirish
            </a>
            
            <div class="security-badge">
                <i class="fas fa-check-circle"></i>
                <span>JSHSHIR ma'lumotlari himoyalangan</span>
                <i class="fas fa-shield-alt"></i>
                <span>Davlat tizimi tomonidan tasdiqlangan</span>
            </div>
        </div>
    </div>

    <!-- Footer -->
    <footer class="footer">
        <div class="footer-content">
            <div class="footer-section">
                <h4><i class="fas fa-map-marked-alt me-2"></i>Qashqadaryo MFY</h4>
                <p>Mahallalararo 24/7 xizmat platformasi</p>
            </div>
            
            <div class="footer-section">
                <h4>Bo'limlar</h4>
                <ul>
                    <li><a href="/">Bosh sahifa</a></li>
                    <li><a href="/qashqadaryo">Tumanlar</a></li>
                    <li><a href="/qashqadaryo/xizmatlar">24/7 Xizmatlar</a></li>
                    <li><a href="/faollar/login">Faollar kabineti</a></li>
                </ul>
            </div>
            
            <div class="footer-section">
                <h4>Favqulodda</h4>
                <ul>
                    <li><i class="fas fa-phone-alt me-2"></i>103 - Tez yordam</li>
                    <li><i class="fas fa-phone-alt me-2"></i>101 - Yong'in</li>
                    <li><i class="fas fa-phone-alt me-2"></i>102 - Militsiya</li>
                </ul>
            </div>
        </div>
        
        <div class="footer-bottom">
            <p>© 2024 Qashqadaryo Mahallalari. Barcha huquqlar himoyalangan.</p>
        </div>
    </footer>

    <!-- Scripts -->
    <script src="https://unpkg.com/aos@2.3.1/dist/aos.js"></script>
    <script>
        AOS.init({
            duration: 1000,
            once: true
        });
    </script>
</body>
</html>
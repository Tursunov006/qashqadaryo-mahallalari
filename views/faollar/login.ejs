<!DOCTYPE html>
<html lang="uz">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Faollar kabineti - Qashqadaryo</title>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.2/css/all.min.css">
    <style>
        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
        }
        
        body {
            font-family: 'Inter', sans-serif;
            background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
            min-height: 100vh;
            display: flex;
            align-items: center;
            justify-content: center;
            padding: 20px;
        }
        
        .login-container {
            max-width: 450px;
            width: 100%;
        }
        
        .login-card {
            background: white;
            border-radius: 40px;
            padding: 40px;
            box-shadow: 0 30px 60px rgba(0,0,0,0.3);
            animation: slideUp 0.6s ease;
        }
        
        @keyframes slideUp {
            from {
                opacity: 0;
                transform: translateY(30px);
            }
            to {
                opacity: 1;
                transform: translateY(0);
            }
        }
        
        .logo {
            text-align: center;
            margin-bottom: 30px;
        }
        
        .logo-icon {
            width: 80px;
            height: 80px;
            background: linear-gradient(135deg, #4CAF50, #2E7D32);
            border-radius: 30px;
            display: flex;
            align-items: center;
            justify-content: center;
            margin: 0 auto 20px;
        }
        
        .logo-icon i {
            font-size: 40px;
            color: white;
        }
        
        .logo h2 {
            color: #1B5E20;
            font-weight: 700;
            margin-bottom: 5px;
        }
        
        .logo p {
            color: #666;
        }
        
        .oneid-btn {
            display: flex;
            align-items: center;
            justify-content: center;
            gap: 10px;
            width: 100%;
            padding: 15px;
            background: linear-gradient(135deg, #1B5E20, #2E7D32);
            color: white;
            text-decoration: none;
            border-radius: 20px;
            font-weight: 600;
            font-size: 1.1rem;
            margin-bottom: 25px;
            transition: 0.3s;
            border: 2px solid #4CAF50;
        }
        
        .oneid-btn:hover {
            transform: translateY(-3px);
            box-shadow: 0 10px 30px rgba(76,175,80,0.4);
        }
        
        .oneid-btn img {
            height: 30px;
            filter: brightness(0) invert(1);
        }
        
        .divider {
            display: flex;
            align-items: center;
            text-align: center;
            margin: 25px 0;
        }
        
        .divider::before,
        .divider::after {
            content: '';
            flex: 1;
            border-bottom: 2px solid #e0e0e0;
        }
        
        .divider span {
            padding: 0 15px;
            color: #666;
            font-weight: 500;
        }
        
        .form-group {
            margin-bottom: 20px;
        }
        
        .form-group label {
            display: block;
            margin-bottom: 8px;
            color: #333;
            font-weight: 600;
        }
        
        .input-group {
            position: relative;
        }
        
        .input-group i {
            position: absolute;
            left: 15px;
            top: 50%;
            transform: translateY(-50%);
            color: #4CAF50;
            font-size: 1.2rem;
        }
        
        .form-control {
            width: 100%;
            padding: 15px 15px 15px 45px;
            border: 2px solid #e0e0e0;
            border-radius: 15px;
            font-size: 1rem;
            transition: 0.3s;
        }
        
        .form-control:focus {
            border-color: #4CAF50;
            outline: none;
            box-shadow: 0 0 0 3px rgba(76,175,80,0.1);
        }
        
        .btn-login {
            width: 100%;
            padding: 15px;
            background: linear-gradient(135deg, #4CAF50, #2E7D32);
            color: white;
            border: none;
            border-radius: 15px;
            font-size: 1.1rem;
            font-weight: 600;
            cursor: pointer;
            transition: 0.3s;
            margin-top: 10px;
        }
        
        .btn-login:hover {
            transform: translateY(-2px);
            box-shadow: 0 10px 20px rgba(76,175,80,0.3);
        }
        
        .error {
            background: #ffebee;
            color: #c62828;
            padding: 15px;
            border-radius: 15px;
            margin-bottom: 20px;
            font-size: 0.95rem;
            display: flex;
            align-items: center;
            gap: 10px;
        }
        
        .error i {
            font-size: 1.2rem;
        }
        
        .test-accounts {
            background: #f8f9fa;
            border-radius: 20px;
            padding: 20px;
            margin: 25px 0;
        }
        
        .test-accounts h4 {
            color: #1B5E20;
            margin-bottom: 15px;
            font-size: 1rem;
            display: flex;
            align-items: center;
            gap: 8px;
        }
        
        .test-grid {
            display: grid;
            grid-template-columns: repeat(auto-fit, minmax(140px, 1fr));
            gap: 10px;
        }
        
        .test-item {
            background: white;
            padding: 12px;
            border-radius: 12px;
            border: 1px solid #e0e0e0;
        }
        
        .test-item .login {
            color: #1B5E20;
            font-weight: 700;
        }
        
        .test-item .pass {
            color: #4CAF50;
            font-size: 0.9rem;
        }
        
        .test-item .role {
            color: #666;
            font-size: 0.8rem;
        }
        
        .security-info {
            display: flex;
            align-items: center;
            justify-content: center;
            gap: 15px;
            margin-top: 20px;
            padding-top: 20px;
            border-top: 2px solid #f0f0f0;
            color: #666;
            font-size: 0.9rem;
        }
        
        .security-info i {
            color: #4CAF50;
        }
        
        .back-link {
            text-align: center;
            margin-top: 20px;
        }
        
        .back-link a {
            color: white;
            text-decoration: none;
            font-size: 0.95rem;
            opacity: 0.9;
        }
        
        .back-link a:hover {
            opacity: 1;
            text-decoration: underline;
        }
    </style>
</head>
<body>
    <div class="login-container">
        <div class="login-card">
            <div class="logo">
                <div class="logo-icon">
                    <i class="fas fa-user-tie"></i>
                </div>
                <h2>Faollar kabineti</h2>
                <p>Qashqadaryo mahalla faollari uchun</p>
            </div>
            
            <% if (error) { %>
                <div class="error">
                    <i class="fas fa-exclamation-circle"></i>
                    <%= error %>
                </div>
            <% } %>
            
            <!-- OneID Tugmasi -->
            <a href="/auth/oneid" class="oneid-btn">
                <img src="https://my.gov.uz/assets/logo.png" alt="OneID">
                OneID orqali kirish
            </a>
            
            <div class="divider">
                <span>YOKI</span>
            </div>
            
            <!-- Oddiy login formasi -->
            <form action="/faollar/login" method="POST">
                <div class="form-group">
                    <label>Login</label>
                    <div class="input-group">
                        <i class="fas fa-user"></i>
                        <input type="text" name="login" class="form-control" 
                               placeholder="Login kiriting" required>
                    </div>
                </div>
                
                <div class="form-group">
                    <label>Parol</label>
                    <div class="input-group">
                        <i class="fas fa-lock"></i>
                        <input type="password" name="parol" class="form-control" 
                               placeholder="●●●●●●●" required>
                    </div>
                </div>
                
                <button type="submit" class="btn-login">
                    <i class="fas fa-sign-in-alt me-2"></i>Kirish
                </button>
            </form>
            
            <!-- Test akkauntlar -->
            <div class="test-accounts">
                <h4>
                    <i class="fas fa-flask"></i>
                    Test ma'lumotlari
                </h4>
                <div class="test-grid">
                    <div class="test-item">
                        <div class="login">rais</div>
                        <div class="pass">123456</div>
                        <div class="role">Mahalla raisi</div>
                    </div>
                    <div class="test-item">
                        <div class="login">inspektor</div>
                        <div class="pass">123456</div>
                        <div class="role">Profilaktika</div>
                    </div>
                    <div class="test-item">
                        <div class="login">xotin</div>
                        <div class="pass">123456</div>
                        <div class="role">Xotin-qizlar</div>
                    </div>
                </div>
            </div>
            
            <!-- Xavfsizlik ma'lumotlari -->
            <div class="security-info">
                <i class="fas fa-shield-alt"></i>
                <span>JSHSHIR himoyalangan</span>
                <i class="fas fa-check-circle"></i>
                <span>OneID tasdiqlangan</span>
            </div>
        </div>
        
        <div class="back-link">
            <a href="/">
                <i class="fas fa-arrow-left me-2"></i>Bosh sahifaga qaytish
            </a>
        </div>
    </div>
</body>
</html>